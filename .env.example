# Copy thành .env rồi sửa:  cp .env.example .env

# Tên hiển thị trên giao diện
APP_NAME=IT Ops Workspace

# Cổng truy cập web: http://<IP-máy-chủ>:8080
PORT=8080

# Mật khẩu PostgreSQL (container db). Chuỗi dài ngẫu nhiên, ví dụ tạo bằng:  openssl rand -hex 24
# Đặt một lần trước lần chạy đầu – đổi sau đó phải đổi cả trong PostgreSQL (ALTER USER itops PASSWORD ...).
POSTGRES_PASSWORD=

# Tài khoản quản trị tạo lần đầu (chỉ dùng khi database còn trống). ĐỔI NGAY sau khi đăng nhập!
ADMIN_USER=admin
ADMIN_PASSWORD=DoiMatKhauNay@2026

# Khoá bí mật để ký phiên đăng nhập và mã hoá mật khẩu thiết bị.
# Để trống: tự sinh và lưu trong ./data/.secret_key (nhớ backup cả thư mục data).
SECRET_KEY=

# true = nạp dữ liệu mẫu để xem thử (xoá được trong Cài đặt > Dữ liệu)
DEMO_DATA=true

# Số ngày giữ lịch sử kết quả check
RETENTION_DAYS=14

# Số check chạy song song tối đa
MAX_PARALLEL_CHECKS=20

# Phiên đăng nhập (giờ)
TOKEN_HOURS=12

# ---- Nhận Syslog / SNMP Trap ----
# Cổng trên máy chủ mà thiết bị gửi tới (mặc định chuẩn 514 và 162)
SYSLOG_PORT=514
TRAP_PORT_HOST=162
# Giữ log bao nhiêu ngày, tối đa bao nhiêu dòng
EVENT_RETENTION_DAYS=30
MAX_EVENTS=2000000
# Chống flood: tối đa số log/giây cho mỗi thiết bị
EVENTS_PER_SEC_PER_SOURCE=200
